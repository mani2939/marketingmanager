NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# Comma-separated Clerk user IDs authorized for both brand workspaces. Empty denies access.
STROZPY_ALLOWED_USER_IDS=
# A pooled PostgreSQL URL with TLS, e.g. Neon; never prefix NEXT_PUBLIC_.
DATABASE_URL=
# Optional: enable the separate public demo, using sample data and browser-local storage only.
ENABLE_DEMO=false
