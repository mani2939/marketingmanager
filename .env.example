# Server-only values. Username is fixed to StrozpyManager.
# Set a strong password of at least 12 characters, then redeploy when changing it.
STROZPY_ADMIN_PASSWORD=
# Independent random value, at least 32 characters; rotate to revoke all sessions.
SESSION_SECRET=
# Neon normally supplies DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
# POSTGRES_URL / POSTGRES_URL_NON_POOLING are also supported.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ENABLE_DEMO=false
