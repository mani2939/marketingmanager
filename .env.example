# Server-only values. Username is fixed to StrozpyManager.
# Set a strong password of at least 12 characters, then redeploy when changing it.
STROZPY_ADMIN_PASSWORD=
# Independent random value, at least 32 characters; rotate to revoke all sessions.
SESSION_SECRET=
# Neon normally supplies DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
# POSTGRES_URL / POSTGRES_URL_NON_POOLING are also supported.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ENABLE_DEMO=false

# Social accounts: canonical HTTPS deployment origin (no path or trailing slash).
APP_URL=
# Generate independently with: openssl rand -hex 32
# Keep stable: changing this key requires reconnecting all social accounts.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Meta app: Facebook Pages and linked Instagram Business/Creator accounts.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Set to the supported version selected in your Meta app dashboard, e.g. v25.0.
META_GRAPH_VERSION=
# TikTok calls its client ID a "client key" in the developer portal.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Google OAuth web application; enable YouTube Data API v3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
